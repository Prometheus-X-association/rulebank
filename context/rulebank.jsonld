{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://w3id.org/dsif/rulebook#",
    "dsif": "https://w3id.org/dsif/rulebook#",
    "ptx": "https://w3id.org/ptx/",
    "dssc": "https://w3id.org/dssc/rulebook/",
    "role": "https://w3id.org/dsif/rulebook/role/",
    "registry": "https://w3id.org/ptx/registry/",
    "edge": "https://w3id.org/ptx/edge/",
    "shape": "https://w3id.org/dsif/rulebook/shape/",
    "dct": "http://purl.org/dc/terms/",
    "odrl": "http://www.w3.org/ns/odrl/2/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "version": "dct:hasVersion",
    "title": "dct:title",
    "statement": {"@id": "dsif:statement", "@container": "@language"},
    "strength": "dsif:ruleStrength",
    "deonticType": "dsif:deonticType",
    "accountable": {"@id": "dsif:accountable", "@type": "@id"},
    "executor": {"@id": "dsif:executor", "@type": "@id"},
    "level": {"@id": "dsif:level", "@type": "xsd:integer"},
    "pattern": "dsif:pattern",
    "parameters": {"@id": "dsif:parameter", "@container": "@set"},
    "name": "dsif:parameterName",
    "datatype": "dsif:datatype",
    "case": "dsif:case",
    "value": "dsif:value",
    "allowedValues": {"@id": "dsif:allowedValue", "@container": "@set"},
    "setAt": {"@id": "dsif:setAtLevel", "@type": "xsd:integer"},
    "stricter": "dsif:stricterDirection",
    "parent": {"@id": "dsif:parentRule"},
    "rule": {"@id": "dsif:rule", "@type": "@id"},
    "baselineVersion": "dsif:baselineVersion",
    "buildingBlock": {"@id": "dsif:buildingBlock", "@container": "@set"},
    "enforcementClass": "dsif:enforcementClass",
    "assuranceLevel": "dsif:assuranceLevel",
    "control": "dsif:control",
    "evidence": {"@id": "dsif:evidence", "@container": "@set"},
    "type": "dsif:type",
    "visibleTo": {"@id": "dsif:visibleTo", "@container": "@set"},
    "trustFramework": "dsif:trustFramework",
    "expressions": {"@id": "dsif:expression", "@container": "@set"},
    "ref": {"@id": "dsif:ref", "@type": "@id"},
    "artifact": "dsif:artifact",
    "check": "dsif:check",
    "coverage": "dsif:coverage",
    "note": "dsif:note",
    "source": {"@id": "dct:source", "@container": "@set"},
    "decisionStatus": "dsif:decisionStatus"
  }
}
